<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/rounded_card_bg"
    android:layout_marginVertical="6dp">

    <TextView
        android:id="@+id/sale_id"
        android:text="Sale ID: SALE567"
        android:textStyle="bold"
        android:layout_height="40dp"
        android:layout_width="400dp" />

    <TextView
        android:id="@+id/sale_date"
        android:text="Date: 2025-11-06"
        android:layout_height="30dp"
        android:layout_width="400dp"/>

    <TextView
        android:id="@+id/sale_total"
        android:text="Total Amount: $899.99"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:layout_height="30dp"
        android:layout_width="400dp"/>

    <TextView
        android:id="@+id/sale_customer_id"
        android:text="Customer ID: 1"
        android:layout_height="30dp"
        android:layout_width="400dp"/>

</LinearLayout>
